{
  "name": "video-to-workcell",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:renderer": "node scripts/setup-renderer.mjs",
    "build": "node scripts/build-renderer.mjs",
    "prepare:data": "python3 scripts/prepare_industreal.py && python3 scripts/prepare_geometry.py",
    "setup": "npm run setup:renderer && npm run prepare:data && npm run build",
    "test": ".venv-mujoco/bin/python -m unittest discover -s scripts -p 'test_*.py' -v && node scripts/test_scene_compiler.mjs",
    "test:browser": "node scripts/test_video_ui.mjs",
    "test:robot": ".venv-mujoco/bin/python scripts/test_robot_runtime.py",
    "test:robot:live": "node scripts/test_robot_ui.mjs",
    "start": ".venv-mujoco/bin/python ui/server.py"
  },
  "dependencies": {"three": "0.180.0", "ajv": "8.17.1"},
  "devDependencies": {"esbuild": "0.25.12"}
}
